C4Context
title C4 System Diagram for Analytics, Billing, Catalog, Identity, Notifications, Ordering, Shipping, Storefront, Warehouse

Enterprise_Boundary(Enterprise, Enterprise, "The enterprise boundary") {
  System(analytics, Analytics, "Collects business events for analysis")
  System(billing, Billing, "Entry point for taking payments")
  System(catalog, Catalog, "Serves product data")
  System(identity, Identity, "Signs customers in")
  System(notifications, Notifications, "Sends email to customers")
  System(ordering, Ordering, "Holds a customer's basket")
  System(shipping, Shipping, "Creates and tracks shipments")
  System(storefront, Storefront, "The customer-facing web shop")
  System(warehouse, Warehouse, "Holds stock for orders")
}
