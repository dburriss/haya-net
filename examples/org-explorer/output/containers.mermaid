C4Container
title C4 Container Diagram for Analytics, Billing, Catalog, Identity, Notifications, Ordering, Shipping, Storefront, Warehouse

System_Boundary(analytics, "Analytics") {
  Container(analytics_event_collector, "EventCollector", "Python 3.12", "Collects business events for analysis")
  ContainerDb(analytics_data_warehouse, "DataWarehouse", "BigQuery", "Store for analytics data")
  Container(analytics_reporting_ui, "ReportingUi", "Metabase", "Dashboards for the business")
}
System_Boundary(billing, "Billing") {
  Container(billing_payments_api, "PaymentsApi", ".NET 10", "Entry point for taking payments")
  Container(billing_payment_gateway, "PaymentGateway", "Java 21", "Talks to card networks and providers")
  Container(billing_ledger_service, "LedgerService", "Java 21", "Double-entry ledger")
  ContainerDb(billing_ledger_db, "LedgerDb", "PostgreSQL", "Store for the ledger")
  Container(billing_refund_service, "RefundService", "Java 21", "Coordinates refunds")
  Container(billing_fraud_check, "FraudCheck", "Python 3.12", "Scores orders for fraud risk")
  Container(billing_fraud_model, "FraudModel", "Python 3.12", "Machine learning model behind the fraud score")
  Container(billing_invoice_worker, "InvoiceWorker", "Java 21", "Produces and sends invoices")
}
System_Boundary(catalog, "Catalog") {
  Container(catalog_catalog_api, "CatalogApi", "Go", "Serves product data")
  ContainerDb(catalog_catalog_db, "CatalogDb", "MongoDB", "Store for products")
  Container(catalog_pricing_service, "PricingService", "Go", "Works out the price of a product or basket")
  Container(catalog_pricing_rules, "PricingRules", "Go", "Holds the pricing rules")
  Container(catalog_search_api, "SearchApi", "Elasticsearch", "Product search")
  Container(catalog_search_indexer, "SearchIndexer", "Go", "Keeps the search index up to date")
  ContainerQueue(catalog_catalog_events, "CatalogEvents", "Kafka", "Stream of product changes")
  Container(catalog_image_service, "ImageService", "Go", "Resizes and serves product images")
  ContainerDb(catalog_image_store, "ImageStore", "S3", "Store for product images")
  Container(catalog_product_importer, "ProductImporter", "Go", "Loads products from supplier feeds")
  Container(catalog_supplier_feed, "SupplierFeed", "Go", "Receives the nightly supplier file")
  Container(catalog_reviews_api, "ReviewsApi", "Go", "Customer product reviews")
  ContainerDb(catalog_reviews_db, "ReviewsDb", "MongoDB", "Store for reviews")
}
System_Boundary(identity, "Identity") {
  Container(identity_auth_api, "AuthApi", "Keycloak", "Signs customers in")
  ContainerDb(identity_user_db, "UserDb", "PostgreSQL", "Store for customer accounts")
  Container(identity_profile_api, "ProfileApi", ".NET 10", "Customer profiles and preferences")
}
System_Boundary(notifications, "Notifications") {
  Container(notifications_email_gateway, "EmailGateway", "Node.js", "Sends email to customers")
  Container(notifications_sms_gateway, "SmsGateway", "Node.js", "Sends text messages to customers")
}
System_Boundary(ordering, "Ordering") {
  Container(ordering_basket_api, "BasketApi", ".NET 10", "Holds a customer's basket")
  ContainerDb(ordering_basket_cache, "BasketCache", "Redis", "Fast storage for active baskets")
  Container(ordering_checkout_api, "CheckoutApi", ".NET 10", "Turns a basket into an order")
  Container(ordering_order_service, "OrderService", ".NET 10", "Owns the lifecycle of an order")
  ContainerDb(ordering_orders_db, "OrdersDb", "PostgreSQL", "Store for orders")
  ContainerQueue(ordering_order_events, "OrderEvents", "Kafka", "Stream of order lifecycle events")
  Container(ordering_order_read_model, "OrderReadModel", ".NET 10", "Query-friendly view of orders")
  ContainerDb(ordering_orders_view_db, "OrdersViewDb", "PostgreSQL", "Store for the order read model")
  Container(ordering_returns_api, "ReturnsApi", ".NET 8", "Handles customer returns")
  Container(ordering_tax_engine, "TaxEngine", "Java", "Third-party tax calculation wrapper")
  Container(ordering_legacy_erp, "LegacyErp", "SAP", "The old ERP, owned by finance")
}
System_Boundary(shipping, "Shipping") {
  Container(shipping_shipment_api, "ShipmentApi", ".NET 10", "Creates and tracks shipments")
  ContainerDb(shipping_shipment_db, "ShipmentDb", "PostgreSQL", "Store for shipments")
  Container(shipping_carrier_gateway, "CarrierGateway", ".NET 10", "Books parcels with carriers")
  Container(shipping_order_tracking, "OrderTracking", ".NET 10", "Tells customers where their parcel is")
}
System_Boundary(storefront, "Storefront") {
  Container(storefront_web_shop, "WebShop", "Next.js", "The customer-facing web shop")
  Container(storefront_mobile_bff, "MobileBff", "Node.js", "Backend for the mobile apps")
  Container(storefront_content_cms, "ContentCms", "Strapi", "Editorial content for the shop")
  ContainerDb(storefront_content_db, "ContentDb", "PostgreSQL", "Store for editorial content")
}
System_Boundary(warehouse, "Warehouse") {
  Container(warehouse_stock_reservation, "StockReservation", "Kotlin", "Holds stock for orders")
  Container(warehouse_stock_levels, "StockLevels", "Kotlin", "Reports what is in stock")
  ContainerDb(warehouse_stock_db, "StockDb", "PostgreSQL", "Store for stock")
  Container(warehouse_picking_app, "PickingApp", "React", "Used by pickers on the warehouse floor")
}
System_Ext(visa, "Visa", "Card network")
System_Ext(stripe, "Stripe", "Card payment provider")
System_Ext(send_grid, "SendGrid", "Email delivery provider")
System_Ext(twilio, "Twilio", "SMS delivery provider")
System_Ext(dhl, "DHL", "Parcel carrier")
System_Ext(post_nl, "PostNL", "Parcel carrier")
Person_Ext(person_customer, "Customer", "Shops for products")
Person(person_picker, "Picker", "Picks and packs orders on the warehouse floor")

Rel(analytics_event_collector, ordering_order_events, "Consume orders", "Kafka")
Rel(analytics_event_collector, catalog_catalog_events, "Consume changes", "Kafka")
Rel(analytics_event_collector, analytics_data_warehouse, "Write events", "Parquet")
Rel(analytics_reporting_ui, analytics_data_warehouse, "Query", "SQL")
Rel(billing_payments_api, billing_payment_gateway, "Authorise", "HTTPS")
Rel(billing_payments_api, visa, "Card network", "HTTPS")
Rel(billing_payment_gateway, stripe, "Charge card", "HTTPS")
Rel(billing_payment_gateway, visa, "Card network", "HTTPS")
Rel(billing_payment_gateway, billing_ledger_service, "Post entry", "gRPC")
Rel(billing_ledger_service, billing_ledger_db, "Persist entries", "PostgreSQL")
Rel(billing_refund_service, billing_payment_gateway, "Refund charge", "HTTPS")
Rel(billing_refund_service, billing_ledger_service, "Post reversal", "gRPC")
Rel(billing_fraud_check, billing_fraud_model, "Score", "gRPC")
Rel(billing_invoice_worker, ordering_order_events, "Consume orders", "Kafka")
Rel(billing_invoice_worker, billing_ledger_service, "Read entries", "gRPC")
Rel(billing_invoice_worker, notifications_email_gateway, "Send invoice", "HTTPS")
Rel(catalog_catalog_api, catalog_catalog_db, "Read products", "MongoDB")
Rel(catalog_catalog_api, catalog_pricing_service, "Prices", "gRPC")
Rel(catalog_catalog_api, warehouse_stock_levels, "Availability", "HTTPS")
Rel(catalog_pricing_service, catalog_pricing_rules, "Load rules", "HTTPS")
Rel(catalog_search_api, catalog_search_indexer, "Query index", "HTTPS")
Rel(catalog_search_indexer, catalog_catalog_events, "Consume changes", "Kafka")
Rel(catalog_image_service, catalog_image_store, "Store images", "S3")
Rel(catalog_product_importer, catalog_catalog_db, "Upsert products", "MongoDB")
Rel(catalog_product_importer, catalog_supplier_feed, "Read feed", "SFTP")
Rel(catalog_reviews_api, catalog_reviews_db, "Persist reviews", "MongoDB")
Rel(identity_auth_api, identity_user_db, "Read users", "PostgreSQL")
Rel(identity_profile_api, identity_user_db, "Read profiles", "PostgreSQL")
Rel(notifications_email_gateway, send_grid, "Deliver email", "HTTPS")
Rel(notifications_sms_gateway, twilio, "Deliver sms", "HTTPS")
Rel(ordering_basket_api, catalog_pricing_service, "Price basket", "gRPC")
Rel(ordering_basket_api, ordering_basket_cache, "Cache baskets", "Redis")
Rel(ordering_checkout_api, ordering_order_service, "Create order", "HTTPS")
Rel(ordering_checkout_api, billing_payments_api, "Request payment", "HTTPS")
Rel(ordering_checkout_api, billing_fraud_check, "Score order", "HTTPS")
Rel(ordering_order_service, ordering_orders_db, "Persist orders", "PostgreSQL")
Rel(ordering_order_service, ordering_order_events, "Publish OrderPlaced", "Kafka")
Rel(ordering_order_service, warehouse_stock_reservation, "Reserve stock", "gRPC")
Rel(ordering_order_service, ordering_tax_engine, "Calculate tax", "HTTPS")
Rel(ordering_order_read_model, ordering_order_events, "Consume orders", "Kafka")
Rel(ordering_order_read_model, ordering_orders_view_db, "Project orders", "PostgreSQL")
Rel(ordering_returns_api, ordering_order_service, "Look up order", "HTTPS")
Rel(ordering_returns_api, billing_refund_service, "Refund", "HTTPS")
Rel(ordering_returns_api, ordering_legacy_erp, "Sync returns", "SOAP")
Rel(shipping_shipment_api, shipping_shipment_db, "Persist shipments", "PostgreSQL")
Rel(shipping_shipment_api, shipping_carrier_gateway, "Book carrier", "HTTPS")
Rel(shipping_shipment_api, ordering_order_events, "Consume orders", "Kafka")
Rel(shipping_carrier_gateway, dhl, "Book parcel", "HTTPS")
Rel(shipping_carrier_gateway, post_nl, "Book parcel", "HTTPS")
Rel(shipping_order_tracking, shipping_shipment_db, "Read status", "PostgreSQL")
Rel(shipping_order_tracking, shipping_carrier_gateway, "Poll tracking", "HTTPS")
Rel(storefront_web_shop, catalog_catalog_api, "Browse products", "HTTPS")
Rel(storefront_web_shop, catalog_search_api, "Search products", "HTTPS")
Rel(storefront_web_shop, ordering_basket_api, "Manage basket", "HTTPS")
Rel(storefront_web_shop, ordering_checkout_api, "Place order", "HTTPS")
Rel(storefront_web_shop, identity_auth_api, "Sign in", "HTTPS")
Rel(person_customer, storefront_web_shop, "Browses and buys")
Rel(storefront_mobile_bff, catalog_catalog_api, "Product data", "HTTPS")
Rel(storefront_mobile_bff, ordering_checkout_api, "Place order", "HTTPS")
Rel(storefront_mobile_bff, identity_auth_api, "Sign in", "HTTPS")
Rel(storefront_mobile_bff, shipping_order_tracking, "Track parcel", "HTTPS")
Rel(person_customer, storefront_mobile_bff, "Browses and buys")
Rel(storefront_content_cms, storefront_content_db, "Read content", "PostgreSQL")
Rel(warehouse_stock_reservation, warehouse_stock_db, "Hold stock", "PostgreSQL")
Rel(warehouse_stock_levels, warehouse_stock_db, "Read stock", "PostgreSQL")
Rel(warehouse_picking_app, warehouse_stock_levels, "Find stock", "HTTPS")
Rel(warehouse_picking_app, shipping_shipment_api, "Confirm picked", "HTTPS")
Rel(person_picker, warehouse_picking_app, "Picks orders")
