<Project Sdk="Microsoft.NET.Sdk">

    <!-- Compiled to TypeScript by Fable and run with Bun. See README.md. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Haya.Core/Types.fs" />
        <Compile Include="../Haya.Core/String.fs" />
        <Compile Include="../Haya.Core/IO.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fable.Core" Version="5.6.1" />
    </ItemGroup>

</Project>
