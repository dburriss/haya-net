<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DefineConstants>TRACE;FABLE_COMPILER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Haya.Core/Types.fs"/>
        <Compile Include="../Haya.Core/String.fs"/>
        <Compile Include="../Haya.Core/IO.fs"/>
        <Content Include="haya.ts" />
        <Content Include="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fable.Core" Version="4.3.0"/>
        <PackageReference Include="Fable.Deno" Version="0.1.0"/>
    </ItemGroup>

</Project>
