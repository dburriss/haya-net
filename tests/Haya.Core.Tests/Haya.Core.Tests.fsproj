<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Code.fs" />
        <Compile Include="SolutionBuilder.fs" />
        <Compile Include="DescriptorTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
        <PackageReference Include="xunit.v3" Version="4.0.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\examples\dotnet\Example\Example.csproj" />
      <ProjectReference Include="..\..\src\Haya.Core\Haya.Core.fsproj" />
      <ProjectReference Include="..\..\src\Haya\Haya.fsproj" />
    </ItemGroup>

</Project>
